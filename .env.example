# ============================================================
# ApexTrader — Environment Variables
# ============================================================
# Copy this file to .env for local development.
# On Railway: set these via the "Variables" panel (NOT in code).
# ============================================================

# --- Server ---
NODE_ENV=production
PORT=4000

# --- Security (REQUIRED in production) ---
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_64_CHARS

# --- CORS ---
# Set to your production domain to block other origins.
# Example: https://yourdomain.com
# Leave empty in dev (allows all origins)
CORS_ORIGIN=https://yourdomain.com

# --- Admin Seed Password ---
# Password for the default admin account (prova@gmail.com).
# Change this BEFORE the first deploy!
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
